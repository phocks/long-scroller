---
import "../styles/global.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <div class="page">
      <main><slot /></main>
      <aside><div class="sidebar-inner"><slot name="sidebar" /></div></aside>
    </div>
  </body>
</html>

<style>
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    background-color: hsl(210, 20%, 98%);
  }

  .page {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    min-height: 120vh;
    background-color: hsl(210, 20%, 97%);
  }

  aside {
    background-color: hsl(210, 25%, 93%);
  }

  .sidebar-inner {
    position: sticky;
    top: 0;
  }

  @media (max-width: 48rem) {
    .page {
      grid-template-columns: 1fr;
    }
    aside {
      position: static;
    }
  }
</style>
